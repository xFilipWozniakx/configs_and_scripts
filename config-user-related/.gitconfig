# This is Git's per-user configuration file.
[user]
	name = Filip Wozniak
	email = filipwu95@gmail.com
[core]
	editor = vim
[color]
	ui = auto
[branch]
	default = main
[advice]
	addIngoredFile = false
[includeIf "gitdir:/data/configs_and_scripts/"]
	path = /home/Filip/.config/git/.gitconfig-configs
[includeIf "gitdir:/data/lab/"]
        path = /home/Filip/.config/git/.gitconfig-lab




