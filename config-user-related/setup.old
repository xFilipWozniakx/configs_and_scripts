#!/usr/bin/bash

# link config files to main directory
create_sys_links() {
	local source="$1"
	local target="${2:-${path:-$HOME}}"
	ln -sf "$source" "$target"
}


for i in .* * ;do
	
	case $i in 
		".") 
			continue
			;;
		"..")
			continue
			;;
		".setup.swp")
			continue
			;;
		"setup")
			continue
			;;
		".gitconfig-configs"|".gitconfig-lab")
			if [[ ! -d ~/.config/git ]];then
			     mkdir -p ~/.config/git
			fi
			echo "gitcofnig-specials added " 
			create_sys_links "$PWD/$i" "${path:-$HOME}/.config/git"
			echo "git config added"
			;;
		"export_extra_path")
			continue
			;;
		"kitty.conf")
			echo "Do i want to overwrite?"
			read answear
			if [[ "${answear}" == "no" ]]; then
				continue
			else
				[[ ! -d ~/.config/kitty ]] && mkdir -p ~/.config/kitty
				create_sys_links "$PWD/$i" "${path:-$HOME}/.config/kitty"
				cp "$PWD/files/kitty/background.jpg" "${path:-$HOME}/.config/kitty"
				echo "kitty added"
			fi
			;;
		"tmux.conf")
			[[ ! -d ~/.config/tmux ]] && mkdir -p ~/.config/tmux
			create_sys_links "$PWD/$i" "${path:-$HOME}/.config/tmux"
			echo "tmux.conf added"		
			;;
		*)
			create_sys_links "$PWD/$i" "${path:-$HOME}"
			;;
	esac
done
