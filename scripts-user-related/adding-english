#!/bin/bash

# Sends POST request to anki deck card software, and automatically adds both side of card in the deck ( english ) retrived from translator script

DECK="English"
MODEL="Basic"
FRONT="$1"
BACK="$2"

curl -s -X POST http://localhost:8765 -d "{
	\"action\": \"addNote\",
	\"version\": 6,
	\"params\": {
		\"note\": {
			\"deckName\": \"$DECK\",
			\"modelName\": \"$MODEL\",
			\"fields\": {
				\"Front\": \"$FRONT\",
				\"Back\": \"$BACK\"
			}
		}
	}
	}" | jq . 


